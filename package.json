{
  "name": "hone",
  "private": true,
  "version": "0.1.0",
  "description": "Hone — mobile-first focus and attention training (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:audio": "bash scripts/gen-letter-audio.sh",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "unmute-ios-audio": "^3.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
